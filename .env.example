# ==============================================================================
# Environment Configuration Template for Datheon Python Internship
# Copy this file to .env and insert your API key(s).
# You do NOT need both keys; either GEMINI_API_KEY or OPENAI_API_KEY is supported.
# ==============================================================================

# Google Gemini API Key (Recommended default, free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Alternative option, available at https://platform.openai.com/)
OPENAI_API_KEY=your_openai_api_key_here

# Default Model Selection (Optional overrides)
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4o-mini
